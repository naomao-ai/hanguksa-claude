// 한국사 마스터 — 공유 문제은행 스키마 (SQLite)
// 개인 학습 기록(풀이 이력/오답/SRS/통계)은 클라이언트 IndexedDB에 저장한다.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Level {
  SIMHWA // 심화 (1~3급)
  GIBON // 기본 (4~6급)
}

model Question {
  id          String   @id @default(cuid())
  level       Level
  examRound   Int? // 회차 (예: 68)
  examYear    Int? // 연도
  number      Int? // 시험 내 문항 번호
  stem             String // 문제 발문
  passage          String? // 사료/자료 제시 지문
  imageUrl         String? // 자료 이미지 (data URL 또는 경로)
  imageDescription String? // 그림/지도/사진 등 시각 자료의 텍스트 묘사 (AI 추출)
  explanation      String? // 해설
  answerIndex Int // 정답 선지 인덱스 (0-base)
  era         String // 시대 키 (domain.ts ERAS)
  topics      String   @default("[]") // 주제/인물 태그 JSON 배열
  qType       String   @default("기타") // 문항 유형
  difficulty  Int? // 1~5 추정 난이도
  source      String   @default("MANUAL") // UPLOAD | MANUAL | SEED
  createdAt   DateTime @default(now())

  choices Choice[]

  @@index([era])
  @@index([level])
  @@index([examRound])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  order      Int // 선지 순서 (0-base)
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// 데이터셋 릴리스(변경이력) — 관리자가 기출 업로드 후 발행.
// "앱 업데이트 기준 정보"의 원천: 현재 버전·최근 반영 회차·문항수·변경 내용.
model Release {
  id            String   @id @default(cuid())
  version       Int      @unique // 1,2,3… 데이터셋 버전
  title         String // 예: "68회 심화 반영"
  notes         String   @default("") // 변경 내용(여러 줄)
  examRound     Int? // 이번에 반영한 최신 회차
  examLevel     String? // SIMHWA | GIBON | BOTH
  questionCount Int      @default(0) // 발행 시점 누적 문항 수 스냅샷
  addedCount    Int      @default(0) // 이번 릴리스에서 추가된 문항 수
  publishedAt   DateTime @default(now())

  @@index([version])
}

// 시대/인물 핵심 사실 — 연표·관계망·플래시카드·튜터 RAG 근거로 사용
model Fact {
  id        String   @id @default(cuid())
  era       String
  year      Int? // 사건 연도 (정렬용)
  title     String // 키워드/사건/인물명
  kind      String   @default("event") // event | person | system | culture
  body      String // 설명
  relatedTo String   @default("[]") // 연결된 Fact title JSON 배열 (관계망)
  createdAt DateTime @default(now())

  @@index([era])
  @@index([kind])
}

// 공부영상 — 최태성 등 국사 학습 영상 (관리자 등록, 게시일 최신순 노출)
model Video {
  id           String   @id @default(cuid())
  youtubeId    String // 11자 영상 ID (임베드/썸네일용)
  url          String // 원본 URL
  title        String
  channel      String?
  thumbnailUrl String?
  publishedAt  DateTime // 영상 게시일(관리자 입력) — 정렬 기준
  aiAnalysis   String   @default("") // 붙여넣은 유튜브 AI 분석 원문
  summary      String   @default("") // Claude가 정리한 카드용 간략 요약
  createdAt    DateTime @default(now())

  @@index([publishedAt])
}
